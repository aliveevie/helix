# ── Helix frontend env ─────────────────────────────────────────────
# Copy to `.env.local` and fill in. ALL are optional: with no values the
# app runs in mock mode against deployments.json (zero addresses).

# --- Chain ---
# Default chain id. 31337 = local anvil/foundry. Use a testnet id otherwise.
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME="Unichain Sepolia"
VITE_NATIVE_NAME="Ether"
VITE_NATIVE_SYMBOL="ETH"
# RPC for the target chain (and for anvil if CHAIN_ID=31337).
VITE_RPC_URL="http://127.0.0.1:8545"
# Separate RPC for the always-available local anvil chain (optional).
VITE_ANVIL_RPC_URL="http://127.0.0.1:8545"
VITE_EXPLORER_NAME="Uniscan"
VITE_EXPLORER_URL="https://sepolia.uniscan.xyz"

# --- Helix contract addresses (HelixAddresses) ---
# Leave any unset to keep the app in mock mode for that surface.
VITE_HOOK_ADDRESS=0x0000000000000000000000000000000000000000
VITE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_REPUTATION_ADDRESS=0x0000000000000000000000000000000000000000
VITE_BREAKER_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
VITE_VALUE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VITE_POOL_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
