{
  "name": "helix-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Helix — Cross-Pool Hedging Router with Reactive Auto-Rebalancing for Uniswap v4",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build",
    "test": "pnpm -r --filter ./packages/* test",
    "engine": "pnpm --filter @helix/matching-engine start",
    "frontend": "pnpm --filter @helix/frontend dev",
    "contracts:test": "cd contracts && forge test",
    "contracts:build": "cd contracts && forge build"
  },
  "license": "MIT"
}
